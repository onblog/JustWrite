{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miaomiao-site",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",

  "observability": {
    "enabled": false
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "r2_buckets": [
    {
      "binding": "R2_RELEASES",
      "bucket_name": "miaomiao-releases"
    }
  ],

  "routes": [
    {
      "pattern": "miaomiao.wordtk.com",
      "custom_domain": true
    }
  ]
}
