{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miaomiao",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",

  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miaomiao",
      "database_id": "f49272d0-7529-4e4b-9cdb-b699d9426bd0",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2_RELEASES",
      "bucket_name": "miaomiao"
    }
  ],

  "routes": [
    {
      "pattern": "miao.wordtk.com",
      "custom_domain": true
    }
  ]
}
